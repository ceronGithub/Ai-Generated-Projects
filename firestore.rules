// ============================================================
// STREETWISE PH — Firestore Security Rules
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // ── Users ────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isLoggedIn() && (request.auth.uid == userId || isOwner());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if isOwner();
    }

    // ── Products ─────────────────────────────────────────────
    match /products/{productId} {
      allow read:  if true;
      allow write: if isOwner();
    }

    // ── Categories ───────────────────────────────────────────
    match /categories/{categoryId} {
      allow read:  if true;
      allow write: if isOwner();
    }

    // ── Inventory ────────────────────────────────────────────
    // Public read + update so guests can decrement stock on checkout.
    // Only owner can create or delete inventory docs.
    match /inventory/{itemId} {
      allow read:           if true;
      allow update:         if true;
      allow create, delete: if isOwner();
    }

    // ── Orders ───────────────────────────────────────────────
    match /orders/{orderId} {
      allow create: if true;
      allow read:   if isOwner() || (isLoggedIn() && resource.data.userId == request.auth.uid);
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    // ── Comments ─────────────────────────────────────────────
    match /comments/{commentId} {
      allow read, create: if true;
      allow delete:       if isOwner();
      allow update:       if isOwner();
    }

    // ── Settings (homepage, contact info) ─────────────────────
    match /settings/{docId} {
      allow read:  if true;
      allow write: if isOwner();
    }
  }
}
